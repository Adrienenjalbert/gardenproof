    "@remotion/google-fonts": "4.0.527",
    "@remotion/renderer": "4.0.527",
    "drizzle-orm": "^0.45.3",
    "nanoid": "^6.0.1",
    "next": "16.3.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.527",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
