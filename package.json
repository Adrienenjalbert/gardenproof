    "plugin:zip": "cd wordpress && zip -rq ../public/gardenproof-portfolio.zip gardenproof-portfolio",
    "worker": "tsx scripts/worker.ts",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
